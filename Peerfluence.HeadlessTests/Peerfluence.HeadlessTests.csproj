<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="PeerSharp" Version="$(PeerSharpPackageVersion)" Condition="'$(UseLocalPeerSharp)' != 'true'" />
    <ProjectReference Include="$(PeerSharpProjectPath)" Condition="'$(UseLocalPeerSharp)' == 'true'" />
    <PackageReference Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <!--
      Registers the TRX reporting option CI asks for. Without it the test host starts,
      finds no option by that name, runs nothing and exits 5 - which reads as "Zero tests
      ran" rather than as an unknown argument. Only TrxReport.Abstractions arrived
      transitively, and that is the contract the reporters implement, not a reporter.
    -->
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peerfluence\Peerfluence.csproj" />
    <ProjectReference Include="..\Peerfluence.Core\Peerfluence.Core.csproj" />
  </ItemGroup>

</Project>
