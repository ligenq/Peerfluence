<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:vm="using:Peerfluence.ViewModels"
                 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:m="using:Peerfluence.Markup"
                 mc:Ignorable="d" d:DesignWidth="860" d:DesignHeight="760"
                 x:Class="Peerfluence.Views.AddTorrentOptionsWindow"
                 x:DataType="vm:AddTorrentOptionsViewModel"
                 Title="{Binding Title}"
                 Width="860" Height="760"
                 MinWidth="760" MinHeight="640"
                 WindowStartupLocation="CenterOwner">

    <suki:BusyArea IsBusy="{Binding IsBusy}">
        <Grid RowDefinitions="*, Auto" Margin="{StaticResource MLargeLeftTopRightBottomMargin}">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="{StaticResource SpacingLarge}">
                    <suki:GlassCard>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *" RowSpacing="{StaticResource SpacingNormal}" ColumnSpacing="{StaticResource SpacingLarge}">
                            <materialIcons:MaterialIcon Grid.RowSpan="2"
                                                        Kind="DownloadBoxOutline"
                                                        Width="42"
                                                        Height="42"
                                                        VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SourceLabel}" Opacity="{StaticResource OpacitySecondary}" TextWrapping="Wrap"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Grid.Column="1" Columns="2" Margin="{StaticResource SmallTopMargin}">
                                <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                    <TextBlock Text="{m:L Details_Size}" Opacity="{StaticResource OpacitySecondary}"/>
                                    <TextBlock Text="{Binding TotalSizeBytes, Converter={StaticResource ByteSizeConverter}}" FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                    <TextBlock Text="{m:L Details_FilesTab}" Opacity="{StaticResource OpacitySecondary}"/>
                                    <TextBlock Text="{Binding FileCount}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </UniformGrid>
                        </Grid>
                    </suki:GlassCard>

                    <suki:GlassCard>
                        <StackPanel Spacing="{StaticResource SpacingStandard}">
                            <TextBlock Text="{m:L AddTorrent_Destination}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"/>
                            <!-- Above the folder, because choosing a category is what fills the folder
                                 in. Absent entirely for anyone who has not defined one. -->
                            <StackPanel Spacing="{StaticResource SpacingXSmall}" IsVisible="{Binding HasCategories}">
                                <TextBlock Text="{m:L AddTorrent_Category}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                <ComboBox x:Name="CategoryPicker"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" AutomationProperties.AutomationId="CategoryComboBox"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                                <TextBox Text="{Binding DownloadPath, Mode=TwoWay}" PlaceholderText="{m:L AddTorrent_DownloadFolderWatermark}" AutomationProperties.AutomationId="DownloadPathTextBox"/>
                                <Button Grid.Column="1" Command="{Binding BrowseDownloadPathCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseDownloadPathButton">
                                    <materialIcons:MaterialIcon Kind="FolderOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                </Button>
                            </Grid>
                            <CheckBox Content="{m:L AddTorrent_StartImmediately}" IsChecked="{Binding StartImmediately}" AutomationProperties.AutomationId="StartImmediatelyCheckBox"/>
                        </StackPanel>
                    </suki:GlassCard>

                    <suki:GlassCard IsVisible="{Binding IsMetadataPending}">
                        <StackPanel Spacing="{StaticResource SpacingNormal}">
                            <TextBlock Text="{m:L AddTorrent_MetadataPendingTitle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{m:L AddTorrent_MetadataPendingBody}"
                                       Opacity="{StaticResource OpacitySecondary}"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding MetadataStatusText}"
                                       Opacity="{StaticResource OpacitySecondary}"
                                       TextWrapping="Wrap"/>
                            <ProgressBar IsIndeterminate="{Binding !HasMetadataProgress}"
                                         Value="{Binding MetadataProgress}"
                                         Minimum="0"
                                         Maximum="1"
                                         IsVisible="{Binding IsFetchingMetadata}"
                                         Height="{StaticResource ProgressBarHeightSlim}"/>
                        </StackPanel>
                    </suki:GlassCard>

                    <suki:GlassCard IsVisible="{Binding HasFiles}">
                        <Grid RowDefinitions="Auto, *" RowSpacing="{StaticResource SpacingStandard}">
                            <TextBlock Text="{m:L Details_FilesTab}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"/>
                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding Files}"
                                      AutoGenerateColumns="False"
                                      CanUserReorderColumns="False"
                                      CanUserResizeColumns="True"
                                      CanUserSortColumns="True"
                                      Height="240" AutomationProperties.AutomationId="FilesGrid">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{m:L Details_Grid_Selected}" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="vm:AddTorrentFileOptionViewModel">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{m:L Details_Grid_Path}" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="{m:L Details_Grid_Size}" Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}}" Width="120" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="{m:L Details_Grid_Priority}" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="vm:AddTorrentFileOptionViewModel">
                                                <ComboBox ItemsSource="{Binding PriorityOptions}" SelectedValue="{Binding Priority, Mode=TwoWay}" SelectedValueBinding="{Binding Value}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </suki:GlassCard>

                    <Expander Header="{m:L AddTorrent_Advanced}" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource SpacingLarge}" Margin="{StaticResource SmallTopMargin}">
                            <suki:GlassCard>
                                <StackPanel Spacing="{StaticResource SpacingStandard}">
                                    <TextBlock Text="{m:L AddTorrent_Metadata}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"/>
                                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="{StaticResource SpacingNormal}" ColumnSpacing="{StaticResource SpacingLarge}">
                                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L AddTorrent_Hash}" Opacity="{StaticResource OpacitySecondary}"/>
                                            <TextBlock Text="{Binding Hash}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L AddTorrent_Version}" Opacity="{StaticResource OpacitySecondary}"/>
                                            <TextBlock Text="{Binding VersionLabel}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L Details_PiecesTab}" Opacity="{StaticResource OpacitySecondary}"/>
                                            <TextBlock Text="{Binding PieceCount}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L AddTorrent_PieceSize}" Opacity="{StaticResource OpacitySecondary}"/>
                                            <TextBlock Text="{Binding PieceSizeBytes, Converter={StaticResource ByteSizeConverter}}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Row="2"
                                                  Grid.ColumnSpan="2"
                                                  Content="{m:L CreateTorrent_Private}"
                                                  IsChecked="{Binding IsPrivate}"
                                                  IsEnabled="False" AutomationProperties.AutomationId="PrivateCheckBox"/>
                                    </Grid>
                                </StackPanel>
                            </suki:GlassCard>

                            <suki:GlassCard>
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="{StaticResource SpacingLarge}">
                                    <StackPanel Spacing="{StaticResource SpacingStandard}">
                                        <TextBlock Text="{m:L AddTorrent_Limits}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"/>
                                        <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*, *" RowSpacing="{StaticResource SpacingNormal}" ColumnSpacing="{StaticResource SpacingNormal}">
                                            <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                                <TextBlock Text="{m:L AddTorrent_DownloadLimitKib}" Opacity="{StaticResource OpacitySecondary}"/>
                                                <NumericUpDown Value="{Binding DownloadLimitKiBPerSecond}" Minimum="0" Increment="64" PlaceholderText="{m:L AddTorrent_GlobalLimitWatermark}" AutomationProperties.AutomationId="DownloadLimitKiBPerSecondInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                                <TextBlock Text="{m:L AddTorrent_UploadLimitKib}" Opacity="{StaticResource OpacitySecondary}"/>
                                                <NumericUpDown Value="{Binding UploadLimitKiBPerSecond}" Minimum="0" Increment="64" PlaceholderText="{m:L AddTorrent_GlobalLimitWatermark}" AutomationProperties.AutomationId="UploadLimitKiBPerSecondInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingXSmall}">
                                                <TextBlock Text="{m:L Details_QueuePriority}" Opacity="{StaticResource OpacitySecondary}"/>
                                                <NumericUpDown Value="{Binding QueuePriority}" Increment="1" AutomationProperties.AutomationId="QueuePriorityInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                                <TextBlock Text="{m:L Details_RatioLimit}" Opacity="{StaticResource OpacitySecondary}"/>
                                                <NumericUpDown Value="{Binding RatioLimit}" Minimum="0" Increment="0.25" PlaceholderText="{m:L AddTorrent_UnlimitedWatermark}" AutomationProperties.AutomationId="RatioLimitInput"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="{StaticResource SpacingXSmall}">
                                                <TextBlock Text="{m:L AddTorrent_SeedTimeLimitMinutes}" Opacity="{StaticResource OpacitySecondary}"/>
                                                <NumericUpDown Value="{Binding SeedTimeLimitMinutes}" Minimum="0" Increment="15" PlaceholderText="{m:L AddTorrent_UnlimitedWatermark}" AutomationProperties.AutomationId="SeedTimeLimitMinutesInput"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingStandard}">
                                        <TextBlock Text="{m:L Details_TrackersTab}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding ExistingTrackers}"
                                                 IsReadOnly="True"
                                                 IsVisible="{Binding HasExistingTrackers}"
                                                 Height="82"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="{m:L AddTorrent_IncludedTrackersWatermark}" AutomationProperties.AutomationId="ExistingTrackersTextBox"/>
                                        <TextBox Text="{Binding AdditionalTrackers, Mode=TwoWay}"
                                                 Height="100"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 PlaceholderText="{m:L AddTorrent_AdditionalTrackersWatermark}" AutomationProperties.AutomationId="AdditionalTrackersTextBox"/>
                                    </StackPanel>
                                </Grid>
                            </suki:GlassCard>
                        </StackPanel>
                    </Expander>

                    <TextBlock Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               Foreground="{StaticResource ErrorColor}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1"
                  ColumnDefinitions="*, Auto"
                  ColumnSpacing="{StaticResource SpacingStandard}"
                  Margin="{StaticResource MediumTopMargin}">
                <CheckBox Content="{m:L AddTorrent_SkipThisStepNextTime}"
                          IsChecked="{Binding SkipThisStepNextTime}"
                          VerticalAlignment="Center" AutomationProperties.AutomationId="SkipThisStepNextTimeCheckBox"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="{StaticResource SpacingStandard}">
                    <Button Content="{m:L Common_Cancel}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="110" AutomationProperties.AutomationId="CancelButton"/>
                    <Button Content="{m:L AddTorrent_Add}" Classes="Flat" Command="{Binding AddCommand}" IsDefault="True" MinWidth="130" AutomationProperties.AutomationId="AddButton"/>
                </StackPanel>
            </Grid>
        </Grid>
    </suki:BusyArea>
</suki:SukiWindow>
