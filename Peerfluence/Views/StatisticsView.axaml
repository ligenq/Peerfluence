<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Peerfluence.ViewModels"
             xmlns:m="using:Peerfluence.Markup"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Peerfluence.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

    <!--
        Read only, so nothing here carries an automation id for acting on: there is nothing to act
        on. The numbers carry them for reading, which is the other half of what an automation id is
        for - a test watching a real download needs to say which figure it is watching - and the page
        itself carries one so a test can say which screen it is looking at. The numbers are formatted
        by the same converters the lists use, so a size means the same thing here as it does there.
    -->
    <ScrollViewer AutomationProperties.AutomationId="StatisticsPage">
        <StackPanel Spacing="{StaticResource SpacingLarge}" Width="{Binding $parent[ScrollViewer].Viewport.Width}" MaxWidth="720" HorizontalAlignment="Left">
            <StackPanel Classes="pageHeader" Margin="{StaticResource ZeroThickness}">
                <TextBlock Text="{m:L Nav_Statistics}" Classes="title"/>
                <TextBlock Text="{m:L Stats_Hint}" Classes="secondary" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Classes="panel">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpacingLarge}" RowSpacing="{StaticResource SpacingStandard}">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Stats_Downloaded}" Classes="secondary"/>
                        <TextBlock Text="{Binding DownloadedBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}" AutomationProperties.AutomationId="StatsDownloadedValue" Classes="display numeric"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Stats_Uploaded}" Classes="secondary"/>
                        <TextBlock Text="{Binding UploadedBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}" AutomationProperties.AutomationId="StatsUploadedValue" Classes="display numeric"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Stats_Ratio}" Classes="secondary"/>
                        <TextBlock Text="{Binding Ratio, StringFormat={}{0:0.00}}" AutomationProperties.AutomationId="StatsRatioValue" Classes="display numeric"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="panel">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Downloads_Grid_Down}" Classes="secondary"/>
                        <TextBlock Text="{Binding DownloadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}, Mode=OneWay}" AutomationProperties.AutomationId="StatsDownloadSpeedValue" Classes="subtitle numeric"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Downloads_Grid_Up}" Classes="secondary"/>
                        <TextBlock Text="{Binding UploadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}, Mode=OneWay}" AutomationProperties.AutomationId="StatsUploadSpeedValue" Classes="subtitle numeric"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="panel">
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Stats_Torrents}" Classes="secondary"/>
                        <TextBlock Text="{Binding Torrents}" AutomationProperties.AutomationId="StatsTorrentsValue" Classes="subtitle numeric"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Downloads_Active}" Classes="secondary"/>
                        <TextBlock Text="{Binding ActiveTorrents}" AutomationProperties.AutomationId="StatsActiveTorrentsValue" Classes="subtitle numeric"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Downloads_Peers}" Classes="secondary"/>
                        <TextBlock Text="{Binding ConnectedPeers}" AutomationProperties.AutomationId="StatsConnectedPeersValue" Classes="subtitle numeric"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
