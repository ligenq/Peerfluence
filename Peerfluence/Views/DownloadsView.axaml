<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Peerfluence.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:m="using:Peerfluence.Markup"
             xmlns:views="using:Peerfluence.Views"
             x:Class="Peerfluence.Views.DownloadsView"
             x:DataType="vm:DownloadsViewModel">
    <suki:BusyArea IsBusy="{Binding IsBusy}">
        <!--
            The last two rows carry the details pane. Their heights are set from code-behind rather
            than here: hiding a control leaves its star-sized row reserving space, which is what left
            the list with half the window and nothing under it.
        -->
        <Grid x:Name="ContentGrid" RowDefinitions="Auto,Auto,Auto,Auto,2*,0,0">
            <!--
                One line instead of four cards. The same four numbers, in the place a status bar
                belongs, leaving the list the room the window was opened for.
            -->
            <Border Margin="{StaticResource StandardBottomMargin}"
                    Padding="{StaticResource NormalLeftTopRightBottomMargin}"
                    Background="{DynamicResource SukiGlassCardBackground}"
                    CornerRadius="{StaticResource CornerRadiusNormal}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingLarge}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="Download" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDownloadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="Upload" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalUploadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <TextBlock Text="{m:L Downloads_Active}" Opacity="{StaticResource OpacitySecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveTorrents}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <TextBlock Text="{m:L Downloads_Peers}" Opacity="{StaticResource OpacitySecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPeers}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        <!--
            Actions say what they do. The destructive one especially: it used to be an unlabelled
            glyph one click away, which is not a thing to leave to a guess.
        -->
        <suki:GlassCard Grid.Row="1" Margin="{StaticResource StandardBottomMargin}" Padding="{StaticResource NormalLeftTopRightBottomMargin}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}" DockPanel.Dock="Left">
                    <Button Classes="Flat" Command="{Binding AddTorrentCommand}" ToolTip.Tip="{m:L Downloads_AddTorrent}" AutomationProperties.Name="{m:L Downloads_AddTorrent}" AutomationProperties.AutomationId="AddTorrentButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Plus" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            <TextBlock Text="{m:L Downloads_AddTorrent}"/>
                        </StackPanel>
                    </Button>

                    <!-- Same weight as Add Torrent: two ways to start the same thing. -->
                    <Button Classes="Flat" Command="{Binding AddMagnetCommand}" ToolTip.Tip="{m:L Downloads_AddMagnet}" AutomationProperties.Name="{m:L Downloads_AddMagnet}" AutomationProperties.AutomationId="AddMagnetButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Magnet" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            <TextBlock Text="{m:L Downloads_AddMagnet}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Command="{Binding StartSelectedCommand}" ToolTip.Tip="{m:L Downloads_Start}" AutomationProperties.Name="{m:L Downloads_Start}" AutomationProperties.AutomationId="StartSelectedButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Play" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            <TextBlock Text="{m:L Downloads_Start}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopSelectedCommand}" ToolTip.Tip="{m:L Downloads_Stop}" AutomationProperties.Name="{m:L Downloads_Stop}" AutomationProperties.AutomationId="StopSelectedButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Stop" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            <TextBlock Text="{m:L Downloads_Stop}"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RemoveSelectedCommand}" ToolTip.Tip="{m:L Downloads_Remove}" Foreground="{StaticResource ErrorColor}" AutomationProperties.Name="{m:L Downloads_Remove}" AutomationProperties.AutomationId="RemoveSelectedButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Delete" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            <TextBlock Text="{m:L Downloads_Remove}"/>
                        </StackPanel>
                    </Button>

                    <Separator Width="1" Height="24" Background="{DynamicResource SukiBorderBrush}" Margin="{StaticResource XXSmallLeftRightMargin}"/>

                    <!--
                        Session-wide, unlike Start and Stop beside it, which act on what is selected.
                        Two buttons rather than one that relabels itself: which one is showing is then
                        also the answer to "is anything running?".
                    -->
                    <Button Command="{Binding ToggleSessionPauseCommand}"
                            ToolTip.Tip="{m:L Downloads_PauseAll}"
                            IsVisible="{Binding !IsSessionPaused}" AutomationProperties.Name="{m:L Downloads_PauseAll}" AutomationProperties.AutomationId="PauseAllButton">
                        <materialIcons:MaterialIcon Kind="PauseCircleOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                    </Button>
                    <Button Command="{Binding ToggleSessionPauseCommand}"
                            ToolTip.Tip="{m:L Downloads_ResumeAll}"
                            IsVisible="{Binding IsSessionPaused}" AutomationProperties.Name="{m:L Downloads_ResumeAll}" AutomationProperties.AutomationId="ResumeAllButton">
                        <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}" Foreground="{DynamicResource SukiPrimaryColor}"/>
                    </Button>

                    <Button Command="{Binding CreateTorrentCommand}" ToolTip.Tip="{m:L CreateTorrent_Title}" AutomationProperties.Name="{m:L CreateTorrent_Title}" AutomationProperties.AutomationId="CreateTorrentButton">
                        <materialIcons:MaterialIcon Kind="File" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                    </Button>

                    <ToggleButton x:Name="DetailsPaneToggle"
                                  IsChecked="{Binding IsDetailsPaneVisible, Mode=OneWay}"
                                  Command="{Binding ToggleDetailsPaneCommand}"
                                  ToolTip.Tip="{m:L Downloads_ToggleDetails}" AutomationProperties.Name="{m:L Downloads_ToggleDetails}" AutomationProperties.AutomationId="ToggleDetailsPaneToggle">
                        <materialIcons:MaterialIcon Kind="DockBottom" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                    </ToggleButton>
                </StackPanel>
            </DockPanel>
        </suki:GlassCard>

        <!-- Finding one torrent among many: search by name, and narrow by what it is doing. -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="{StaticResource SpacingMedium}"
              IsVisible="{Binding HasTorrents}"
              Margin="{StaticResource StandardBottomMargin}">
            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                <!-- One chip per category, in the same row and the same idiom as the state filters,
                     and only there at all once categories exist. -->
                <ItemsControl ItemsSource="{Binding Categories}" IsVisible="{Binding HasCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <RadioButton Classes="Chips" GroupName="CategoryFilter"
                                         Content="{Binding}"
                                         Command="{Binding $parent[ItemsControl].((vm:DownloadsViewModel)DataContext).SetCategoryFilterCommand}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <RadioButton Classes="Chips" GroupName="CategoryFilter"
                             IsVisible="{Binding HasCategories}"
                             IsChecked="{Binding IsAllCategories, Mode=TwoWay}"
                             Content="{m:L Downloads_Category_All}" AutomationProperties.AutomationId="CategoryFilterAllRadioButton"/>
                <RadioButton Classes="Chips" GroupName="TorrentFilter" IsChecked="{Binding IsFilterAll, Mode=TwoWay}"
                             Content="{m:L Downloads_Filter_All}" AutomationProperties.AutomationId="FilterAllRadioButton"/>
                <RadioButton Classes="Chips" GroupName="TorrentFilter" IsChecked="{Binding IsFilterDownloading, Mode=TwoWay}"
                             Content="{m:L Downloads_Filter_Downloading}" AutomationProperties.AutomationId="FilterDownloadingRadioButton"/>
                <RadioButton Classes="Chips" GroupName="TorrentFilter" IsChecked="{Binding IsFilterSeeding, Mode=TwoWay}"
                             Content="{m:L Downloads_Filter_Seeding}" AutomationProperties.AutomationId="FilterSeedingRadioButton"/>
                <RadioButton Classes="Chips" GroupName="TorrentFilter" IsChecked="{Binding IsFilterCompleted, Mode=TwoWay}"
                             Content="{m:L Downloads_Filter_Completed}" AutomationProperties.AutomationId="FilterCompletedRadioButton"/>
            </StackPanel>
            <TextBox Grid.Column="1"
                     Text="{Binding SearchText, Mode=TwoWay}"
                     PlaceholderText="{m:L Downloads_Search}"
                     MaxWidth="320"
                     HorizontalAlignment="Right" AutomationProperties.Name="{m:L Downloads_Search}" AutomationProperties.AutomationId="SearchTextTextBox"/>
        </Grid>

        <suki:InfoBar x:Name="DownloadsStatusInfoBar"
                      Grid.Row="3"
                      IsVisible="{Binding HasStatusMessage}"
                      IsClosable="True"
                      Message="{Binding StatusMessage}"
                      Margin="{StaticResource StandardBottomMargin}" />

        <!-- Searched everything away: say so, rather than showing an empty grid. -->
        <TextBlock Grid.Row="4"
                   Text="{m:L Downloads_NoMatches}"
                   IsVisible="{Binding HasNoMatches}"
                   Opacity="{StaticResource OpacitySecondary}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Torrent List -->
        <suki:GlassCard x:Name="TorrentTableCard"
                        Grid.Row="4"
                        Padding="{StaticResource ZeroThickness}"
                        IsVisible="{Binding HasTorrents}">
            <DataGrid x:Name="TorrentDataGrid"
                      ItemsSource="{Binding VisibleTorrents}"
                      SelectedItem="{Binding SelectedTorrent, Mode=TwoWay}"
                      SelectionChanged="TorrentDataGrid_OnSelectionChanged"
                      PointerPressed="TorrentDataGrid_OnPointerPressed"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      HeadersVisibility="Column"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="None"
                      BorderThickness="0" AutomationProperties.AutomationId="TorrentGrid">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{m:L Downloads_Start}" Command="{Binding StartSelectedCommand}" AutomationProperties.AutomationId="StartSelectedMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Play" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{m:L Downloads_Stop}" Command="{Binding StopSelectedCommand}" AutomationProperties.AutomationId="StopSelectedMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Stop" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{m:L Downloads_OpenFolder}" Command="{Binding OpenFolderCommand}" AutomationProperties.AutomationId="OpenFolderMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FolderOpen" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{m:L Downloads_ForceRecheck}" Command="{Binding ForceRecheckCommand}" AutomationProperties.AutomationId="ForceRecheckMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FileFind" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{m:L Downloads_CopyHash}" Command="{Binding CopyHashCommand}" AutomationProperties.AutomationId="CopyHashMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="ContentCopy" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{m:L Downloads_CopyMagnet}" Command="{Binding CopyMagnetCommand}" AutomationProperties.AutomationId="CopyMagnetMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Magnet" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{m:L Downloads_Remove}" Command="{Binding RemoveSelectedCommand}" Foreground="{StaticResource ErrorColor}" AutomationProperties.AutomationId="RemoveSelectedMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="Delete" Foreground="{StaticResource ErrorColor}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="{m:L Downloads_Category}" ItemsSource="{Binding Categories}" AutomationProperties.AutomationId="CategoriesMenuItem">
                            <MenuItem.Icon>
                                <materialIcons:MaterialIcon Kind="FolderMultipleOutline" />
                            </MenuItem.Icon>
                            <MenuItem.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}"/>
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                            <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem">
                                    <Setter Property="Command" Value="{Binding $parent[DataGrid].((vm:DownloadsViewModel)DataContext).AssignCategoryCommand}"/>
                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                </Style>
                            </MenuItem.Styles>
                        </MenuItem>
                        <MenuItem Header="{m:L Downloads_Category_None}"
                                  Command="{Binding AssignCategoryCommand}"
                                  CommandParameter="{x:Null}" AutomationProperties.AutomationId="AssignCategoryMenuItem"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{m:L Downloads_Grid_Name}" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TorrentListItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}" Margin="{StaticResource NormalLeftRightMargin}">
                                    <materialIcons:MaterialIcon Kind="FileOutline" Width="{StaticResource IconSizeNormal}" Height="{StaticResource IconSizeNormal}" Opacity="{StaticResource OpacitySecondary}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{m:L Downloads_Grid_Progress}" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TorrentListItemViewModel">
                                <StackPanel VerticalAlignment="Center" Margin="{StaticResource NormalLeftRightMargin}" Spacing="{StaticResource SpacingTiny}">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="{StaticResource ProgressBarHeight}" CornerRadius="{StaticResource CornerRadiusSmall}" />
                                    <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:F1}%'}" FontSize="{StaticResource FontSizeTiny}" HorizontalAlignment="Right" Opacity="{StaticResource OpacitySecondary}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{m:L Downloads_Grid_Size}"
                                        Binding="{Binding TotalSizeBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"
                                        SortMemberPath="TotalSizeBytes"
                                        Width="100"/>
                    <DataGridTextColumn Header="{m:L Downloads_Grid_Category}" Binding="{Binding Category}" Width="120"/>
                    <DataGridTextColumn Header="{m:L Downloads_Grid_State}" Binding="{Binding State}" Width="100"/>
                    <DataGridTextColumn Header="{m:L Downloads_Grid_Eta}" Binding="{Binding Eta}" Width="100"/>

                    <DataGridTemplateColumn Header="{m:L Downloads_Grid_Down}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TorrentListItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}" Margin="{StaticResource NormalLeftRightMargin}" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowDown" Width="{StaticResource IconSizeMicro}" Height="{StaticResource IconSizeMicro}" Foreground="{DynamicResource SukiPrimaryColor}"/>
                                    <TextBlock Text="{Binding DownloadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" FontSize="{StaticResource FontSizeNormal}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="{m:L Downloads_Grid_Up}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="vm:TorrentListItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmall}" Margin="{StaticResource NormalLeftRightMargin}" VerticalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ArrowUp" Width="{StaticResource IconSizeMicro}" Height="{StaticResource IconSizeMicro}" Foreground="{DynamicResource SukiPrimaryColor}"/>
                                    <TextBlock Text="{Binding UploadSpeedBytesPerSecond, Converter={StaticResource SpeedConverter}}" FontSize="{StaticResource FontSizeNormal}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="{m:L Downloads_Grid_Peers}" Binding="{Binding ConnectedPeers}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </suki:GlassCard>

        <!--
            Nothing added yet. The same restraint as simple mode: the two buttons that add a
            download are directly above, so an accent icon and a copy of them underneath is
            decoration, not help. Named still, because tests find it by name.
        -->
        <StackPanel x:Name="EmptyStateCard"
                    Grid.Row="4"
                    Grid.RowSpan="3"
                    IsVisible="{Binding HasNoTorrents}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="460"
                    Spacing="{StaticResource SpacingSmall}">
            <TextBlock Text="{m:L Downloads_EmptyTitle}"
                       FontSize="{StaticResource FontSizeLarge}"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{m:L Downloads_EmptyBody}"
                       Opacity="{StaticResource OpacitySecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>
        <!-- Detail Pane (Resizable) -->
        <GridSplitter Grid.Row="5" Height="4" HorizontalAlignment="Stretch" Background="Transparent"
                      IsVisible="{Binding IsDetailsPaneVisible}" />
        <suki:GlassCard Grid.Row="6"
                        IsVisible="{Binding IsDetailsPaneVisible}"
                        Margin="{StaticResource ZeroThickness}"
                        Padding="{StaticResource ZeroThickness}">
            <ContentControl Content="{Binding SelectedTorrentDetailViewModel}" />
        </suki:GlassCard>
    </Grid>
    </suki:BusyArea>
</UserControl>
