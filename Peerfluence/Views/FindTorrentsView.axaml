<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pf="using:Peerfluence.Theme.Controls"
             xmlns:vm="using:Peerfluence.ViewModels"
             xmlns:controls="using:Peerfluence.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:m="using:Peerfluence.Markup"
             x:Class="Peerfluence.Views.FindTorrentsView"
             x:DataType="vm:FindTorrentsViewModel">
    <Panel>
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <StackPanel Grid.Row="0" Classes="pageHeader">
                <TextBlock Text="{m:L Nav_FindTorrents}" Classes="title"/>
                <TextBlock Text="{m:L Find_Hint}" Classes="secondary" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1"
                  x:Name="QueryBar"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="{StaticResource SpacingMedium}"
                  IsVisible="{Binding IsConfigured}"
                  Margin="{StaticResource StandardBottomMargin}">
                <TextBox Text="{Binding Query, Mode=TwoWay}"
                         PlaceholderText="{m:L Find_QueryWatermark}" AutomationProperties.Name="{m:L Find_QueryWatermark}" AutomationProperties.AutomationId="QueryTextBox">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="accent" Command="{Binding SearchCommand}" AutomationProperties.Name="{m:L Find_Search}" AutomationProperties.AutomationId="SearchButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                        <materialIcons:MaterialIcon Kind="Magnify" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                        <TextBlock Text="{m:L Find_Search}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--
                Said rather than hidden. A search that returned nothing because two indexes timed
                out is a different problem from one that found nothing, and only the user can tell
                which they care about.
            -->
            <StackPanel Grid.Row="2"
                        IsVisible="{Binding HasStatusMessage}"
                        Spacing="{StaticResource SpacingSmall}"
                        Margin="{StaticResource StandardBottomMargin}">
                <pf:InfoBar IsClosable="False" Message="{Binding StatusMessage}"/>
                <!-- Only where it would help: a timeout on someone else's tracker is not a settings
                     problem, and offering the settings for it wastes the trip. -->
                <Button x:Name="FixInSettingsButton"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding CanFixInSettings}"
                        Command="{Binding OpenSearchSettingsCommand}" AutomationProperties.Name="{m:L Find_OpenSearchSettings}" AutomationProperties.AutomationId="OpenSearchSettingsButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                        <materialIcons:MaterialIcon Kind="Cog" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                        <TextBlock Text="{m:L Find_OpenSearchSettings}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border Classes="panel" Grid.Row="3"
                            x:Name="ResultsCard"
                            IsVisible="{Binding IsConfigured}"
                            Padding="{StaticResource ZeroThickness}">
                <DataGrid x:Name="ResultsGrid"
                          ItemsSource="{Binding Results}"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                          DoubleTapped="ResultsGrid_OnDoubleTapped"
                          SelectionMode="Single"
                          AutoGenerateColumns="False"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="None"
                          BorderThickness="0" AutomationProperties.AutomationId="ResultGrid">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{m:L Find_Add}" Command="{Binding AddCommand}" CommandParameter="{Binding SelectedResult}" AutomationProperties.AutomationId="AddMenuItem">
                                <MenuItem.Icon>
                                    <materialIcons:MaterialIcon Kind="Plus"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{m:L Find_Column_Name}" Binding="{Binding Title}" Width="*" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchTitle}"/>
                        <DataGridTextColumn Header="{m:L Downloads_Grid_Size}"
                                            Binding="{Binding SizeBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}"
                                            Width="100" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchSize}"/>
                        <DataGridTextColumn Header="{m:L Find_Column_Seeds}"
                                            Binding="{Binding SeedersText}"
                                            Width="80" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchSeeds}"/>
                        <DataGridTextColumn Header="{m:L Downloads_Grid_Peers}"
                                            Binding="{Binding PeersText}"
                                            Width="80" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchPeers}"/>
                        <DataGridTextColumn Header="{m:L Find_Column_Indexer}" Binding="{Binding IndexerName}" Width="140" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchIndexer}"/>
                        <DataGridTextColumn Header="{m:L Find_Column_Age}" Binding="{Binding AgeText}" Width="80" CanUserSort="True" CustomSortComparer="{x:Static controls:DataGridComparers.SearchAge}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <StackPanel Grid.Row="3"
                        x:Name="EmptyState"
                        IsVisible="{Binding IsNotConfigured}"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MaxWidth="420"
                        Spacing="{StaticResource SpacingNormal}">
                <TextBlock Text="{m:L Find_NotConfiguredTitle}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{m:L Find_NotConfiguredBody}"
                           Opacity="{StaticResource OpacitySecondary}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"/>
                <!-- Naming the settings and leaving the user to find them is half an answer. -->
                <Button x:Name="SetUpIndexerButton"
                        HorizontalAlignment="Center"
                        Margin="{StaticResource SmallTopMargin}"
                        Command="{Binding OpenSearchSettingsCommand}"
                        Content="{m:L Find_SetUpIndexer}" AutomationProperties.AutomationId="FindTorrentsOpenSearchSettingsButton"/>
            </StackPanel>
        </Grid>
    <!-- Covers the content while work is in flight, so nothing can be acted on mid-flight. -->
        <Border Background="{DynamicResource PfScrim}" IsVisible="{Binding IsSearching}">
            <ProgressBar IsIndeterminate="True" Width="180"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
