<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Peerfluence.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
             xmlns:m="using:Peerfluence.Markup"
             xmlns:config="using:Peerfluence.Core.Config"
             x:Class="Peerfluence.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <Grid RowDefinitions="Auto,*" Margin="{StaticResource MediumLeftTopRightBottomMargin}">
        <suki:GlassCard Padding="{StaticResource NormalLeftTopRightBottomMargin}" Margin="{StaticResource StandardBottomMargin}">
            <StackPanel Spacing="{StaticResource SpacingStandard}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_Title}" FontSize="{StaticResource FontSizeHeader}" FontWeight="Bold"/>
                        <!-- No Save button: changes apply as they are made, so say that instead. -->
                        <TextBlock Text="{m:L Settings_SavedAutomatically}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource SpacingStandard}" HorizontalAlignment="Right">
                        <Button Command="{Binding ResetDefaultsCommand}" Classes="Accent" AutomationProperties.Name="{m:L Settings_Reset}" AutomationProperties.AutomationId="ResetDefaultsButton">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                                <materialIcons:MaterialIcon Kind="Restore" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                <TextBlock Text="{m:L Settings_Reset}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <suki:InfoBar x:Name="SettingsStatusInfoBar"
                              IsVisible="{Binding HasStatusMessage}"
                              IsClosable="False"
                              Message="{Binding StatusMessage}" />
            </StackPanel>
        </suki:GlassCard>

        <TabControl x:Name="SettingsTabs" Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{m:L Settings_Appearance}" AutomationProperties.Name="{m:L Settings_Appearance}" AutomationProperties.AutomationId="AppearanceTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">

            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_InterfaceMode}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- The only way back to simple mode once advanced has been chosen. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <RadioButton Classes="Chips" GroupName="InterfaceMode"
                                     IsChecked="{Binding SimpleModeSelected, Mode=TwoWay}"
                                     Content="{m:L Settings_InterfaceMode_Simple}" AutomationProperties.AutomationId="InterfaceModeSimpleRadioButton"/>
                        <RadioButton Classes="Chips" GroupName="InterfaceMode"
                                     IsChecked="{Binding AdvancedModeSelected, Mode=TwoWay}"
                                     Content="{m:L Settings_InterfaceMode_Advanced}" AutomationProperties.AutomationId="InterfaceModeAdvancedRadioButton"/>
                    </StackPanel>
                    <TextBlock Text="{m:L Settings_InterfaceModeHint}"
                               Opacity="{StaticResource OpacityHint}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </suki:GlassCard>

            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="PaletteOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_Appearance}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource SpacingLarge}" RowSpacing="{StaticResource SpacingStandard}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ThemeVariant}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <ComboBox ItemsSource="{Binding ThemeVariantOptions}" SelectedValue="{Binding SelectedThemeVariant}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_ThemeVariant}" AutomationProperties.AutomationId="ThemeVariantComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ColorTheme}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <ComboBox ItemsSource="{Binding ColorThemeOptions}" SelectedValue="{Binding SelectedColorTheme}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_ColorTheme}" AutomationProperties.AutomationId="ColorThemeComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_BackgroundStyle}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <ComboBox ItemsSource="{Binding BackgroundStyleOptions}" SelectedValue="{Binding SelectedBackgroundStyle}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_BackgroundStyle}" AutomationProperties.AutomationId="BackgroundStyleComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_Language}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedValue="{Binding SelectedLanguage}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_Language}" AutomationProperties.AutomationId="LanguageComboBox">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_StorageAndSession}" AutomationProperties.Name="{m:L Settings_StorageAndSession}" AutomationProperties.AutomationId="StorageAndSessionTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="FolderNetworkOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_StorageAndSession}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <TextBlock Text="{m:L Settings_DownloadFolder}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                            <TextBox Text="{Binding DownloadPath, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_DownloadFolder}" AutomationProperties.AutomationId="SettingsDownloadPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseDownloadPathCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="SettingsBrowseDownloadPathButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <TextBlock Text="{m:L Settings_SessionFolder}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                            <TextBox Text="{Binding SessionPath, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_SessionFolder}" AutomationProperties.AutomationId="SessionPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseSessionPathCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseSessionPathButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!--
                        A directory that adds what is dropped into it: the other half of the loop
                        the completion action already gave the end of.
                    -->
                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <ToggleSwitch IsChecked="{Binding WatchFolderEnabled, Mode=TwoWay}" Content="{m:L Settings_EnableWatchFolder}" AutomationProperties.AutomationId="EnableWatchFolderSwitch"/>
                        <TextBlock Text="{m:L Settings_WatchFolderHint}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}" IsEnabled="{Binding WatchFolderEnabled}">
                            <TextBox Text="{Binding WatchFolderPath, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_WatchFolder}" AutomationProperties.AutomationId="WatchFolderPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseWatchFolderPathCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseWatchFolderPathButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableSessionPersistence, Mode=TwoWay}" Content="{m:L Settings_EnableSessionPersistence}" AutomationProperties.AutomationId="EnableSessionPersistenceSwitch"/>
                    <ToggleSwitch IsChecked="{Binding ShowAddTorrentOptions, Mode=TwoWay}" Content="{m:L Settings_ShowAddTorrentOptions}" AutomationProperties.AutomationId="ShowAddTorrentOptionsSwitch"/>
                    <ToggleSwitch IsChecked="{Binding ShowRemoveTorrentOptions, Mode=TwoWay}" Content="{m:L Settings_ShowRemoveTorrentOptions}" AutomationProperties.AutomationId="ShowRemoveTorrentOptionsSwitch"/>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard IsVisible="{Binding CanManageWindowsAssociations}">
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="LinkVariant" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_WindowsAssociations}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding AssociateTorrentFiles, Mode=TwoWay}" Content="{m:L Settings_AssociateTorrentFiles}" AutomationProperties.AutomationId="AssociateTorrentFilesSwitch"/>
                    <ToggleSwitch IsChecked="{Binding AssociateMagnetLinks, Mode=TwoWay}" Content="{m:L Settings_AssociateMagnetLinks}" AutomationProperties.AutomationId="AssociateMagnetLinksSwitch"/>
                    <TextBlock Text="{m:L Settings_WindowsAssociationsHint}"
                               Opacity="{StaticResource OpacityHint}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="PlayCircleOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_MediaPlayer}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_MediaPlayerPath}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                            <TextBox Text="{Binding MediaPlayerPath, Mode=TwoWay}" PlaceholderText="{m:L Settings_MediaPlayerWatermark}" AutomationProperties.Name="{m:L Settings_MediaPlayerPath}" AutomationProperties.AutomationId="MediaPlayerPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseMediaPlayerCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseMediaPlayerButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="ConsoleLine" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_CompletionAction}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding CompletionActionEnabled, Mode=TwoWay}" Content="{m:L Settings_CompletionActionEnabled}" AutomationProperties.AutomationId="CompletionActionEnabledSwitch"/>

                    <StackPanel Spacing="{StaticResource SpacingStandard}" IsEnabled="{Binding CompletionActionEnabled}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_CompletionActionProgram}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                                <TextBox Text="{Binding CompletionActionProgramPath, Mode=TwoWay}" PlaceholderText="{m:L Settings_CompletionActionProgramWatermark}" AutomationProperties.Name="{m:L Settings_CompletionActionProgram}" AutomationProperties.AutomationId="CompletionActionProgramPathTextBox"/>
                                <Button Grid.Column="1" Command="{Binding BrowseCompletionActionProgramCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseCompletionActionProgramButton">
                                    <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_CompletionActionArguments}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding CompletionActionArgumentsTemplate, Mode=TwoWay}" PlaceholderText="{m:L Settings_CompletionActionArgumentsWatermark}" AutomationProperties.Name="{m:L Settings_CompletionActionArguments}" AutomationProperties.AutomationId="CompletionActionArgumentsTemplateTextBox"/>
                        </StackPanel>

                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_CompletionActionWorkingDirectory}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding CompletionActionWorkingDirectoryTemplate, Mode=TwoWay}" PlaceholderText="{m:L Settings_CompletionActionWorkingDirectoryWatermark}" AutomationProperties.Name="{m:L Settings_CompletionActionWorkingDirectory}" AutomationProperties.AutomationId="CompletionActionWorkingDirectoryTemplateTextBox"/>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                            <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                <TextBlock Text="{m:L Settings_CompletionActionTimeoutSeconds}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                <NumericUpDown Value="{Binding CompletionActionTimeoutSeconds}" Minimum="1" AutomationProperties.Name="{m:L Settings_CompletionActionTimeoutSeconds}" AutomationProperties.AutomationId="CompletionActionTimeoutSecondsInput"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                <TextBlock Text="{m:L Settings_CompletionActionWindow}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                <ToggleSwitch IsChecked="{Binding CompletionActionRunHidden, Mode=TwoWay}" Content="{m:L Settings_CompletionActionRunHidden}" AutomationProperties.AutomationId="CompletionActionRunHiddenSwitch"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{m:L Settings_CompletionActionTokens}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_NetworkAndConnectivity}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_NetworkAndConnectivity}" AutomationProperties.AutomationId="NetworkAndConnectivityTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="TransitConnectionVariant" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_NetworkAndConnectivity}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <TextBlock Text="{m:L Settings_PortMapping}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <Button Command="{Binding RefreshPortMappingCommand}" HorizontalAlignment="Left" AutomationProperties.Name="{m:L Settings_PortMapping_Refresh}" AutomationProperties.AutomationId="RefreshPortMappingButton">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                                <materialIcons:MaterialIcon Kind="Refresh" Width="{StaticResource IconSizeNormal}" Height="{StaticResource IconSizeNormal}"/>
                                <TextBlock Text="{m:L Settings_PortMapping_Refresh}"/>
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding PortMappingStatuses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PortMappingStatusViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}" Margin="{StaticResource MicroTopBottomMargin}">
                                        <Border Width="{StaticResource StatusDotSize}" Height="{StaticResource StatusDotSize}" CornerRadius="{StaticResource CornerRadiusNormal}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding StatusColor}"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Protocol}" FontWeight="SemiBold" Width="80"/>
                                        <TextBlock Text="{Binding DisplayText}" Opacity="{StaticResource OpacitySecondary}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <WrapPanel Orientation="Horizontal">
                        <ToggleSwitch IsChecked="{Binding EnableDht, Mode=TwoWay}" Content="{m:L Settings_EnableDht}" Margin="{StaticResource MediumRightMargin}" AutomationProperties.AutomationId="EnableDhtSwitch"/>
                        <ToggleSwitch IsChecked="{Binding EnableNatPmp, Mode=TwoWay}" Content="{m:L Settings_EnableNatPmp}" Margin="{StaticResource MediumRightMargin}" AutomationProperties.AutomationId="EnableNatPmpSwitch"/>
                        <ToggleSwitch IsChecked="{Binding EnableUpnp, Mode=TwoWay}" Content="{m:L Settings_EnableUpnp}" AutomationProperties.AutomationId="EnableUpnpSwitch"/>
                    </WrapPanel>

                    <StackPanel Spacing="{StaticResource SpacingSmall}" IsEnabled="{Binding EnableDht}">
                        <ToggleSwitch IsChecked="{Binding AnswerInfoHashSampling, Mode=TwoWay}"
                                      Content="{m:L Settings_AnswerInfoHashSampling}" AutomationProperties.AutomationId="AnswerInfoHashSamplingSwitch"/>
                        <TextBlock Text="{m:L Settings_AnswerInfoHashSamplingHint}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingSmall}">
                        <ToggleSwitch IsChecked="{Binding AllowMultipleConnectionsPerIp, Mode=TwoWay}"
                                      Content="{m:L Settings_AllowMultipleConnectionsPerIp}" AutomationProperties.AutomationId="AllowMultipleConnectionsPerIpSwitch"/>
                        <TextBlock Text="{m:L Settings_AllowMultipleConnectionsPerIpHint}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_MaxConnectionsPerIp}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <NumericUpDown Value="{Binding MaxConnectionsPerIp}" Minimum="0" Increment="1" AutomationProperties.Name="{m:L Settings_MaxConnectionsPerIp}" AutomationProperties.AutomationId="MaxConnectionsPerIpInput"/>
                        <TextBlock Text="{m:L Settings_MaxConnectionsPerIpHint}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_BindAddress}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <TextBox Text="{Binding BindAddress, Mode=TwoWay}" PlaceholderText="192.168.1.50" AutomationProperties.Name="{m:L Settings_BindAddress}" AutomationProperties.AutomationId="BindAddressTextBox"/>
                        <TextBlock Text="{m:L Settings_BindAddressInvalid}"
                                   Foreground="{StaticResource ErrorColor}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding !IsBindAddressValid}"/>
                        <TextBlock Text="{m:L Settings_BindAddressHint}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <ToggleSwitch IsChecked="{Binding UseAutomaticListeningPort, Mode=TwoWay}" Content="{m:L Settings_UseAutomaticListeningPort}" AutomationProperties.AutomationId="UseAutomaticListeningPortSwitch"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}" IsEnabled="{Binding IsFixedListeningPortEnabled}">
                            <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                <TextBlock Text="{m:L Settings_ListeningPort}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                <NumericUpDown Value="{Binding ListeningPort}" Minimum="1" Maximum="65535" Increment="1" AutomationProperties.Name="{m:L Settings_ListeningPort}" AutomationProperties.AutomationId="ListeningPortInput"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{m:L Settings_ListeningPortHint}"
                                       Opacity="{StaticResource OpacityHint}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{m:L Settings_PortRestartHint}"
                                   Opacity="{StaticResource OpacityHint}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="Speedometer" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_Performance}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- The setting people reach for while a download is running, so it is above the
                         disk throttles rather than below them. Applied to the running engine at once. -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_DownloadLimit}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown x:Name="DownloadLimitBox" Value="{Binding MaxDownloadSpeedKibibytesPerSecond}" Minimum="0" Increment="128" AutomationProperties.Name="{m:L Settings_DownloadLimit}" AutomationProperties.AutomationId="MaxDownloadSpeedKibibytesPerSecondInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_UploadLimit}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown x:Name="UploadLimitBox" Value="{Binding MaxUploadSpeedKibibytesPerSecond}" Minimum="0" Increment="128" AutomationProperties.Name="{m:L Settings_UploadLimit}" AutomationProperties.AutomationId="MaxUploadSpeedKibibytesPerSecondInput"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{m:L Settings_SpeedLimitHint}"
                               Opacity="{StaticResource OpacityHint}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_DiskReadLimit}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown Value="{Binding MaxDiskReadSpeedBytesPerSecond}" Minimum="0" Increment="1048576" AutomationProperties.Name="{m:L Settings_DiskReadLimit}" AutomationProperties.AutomationId="MaxDiskReadSpeedInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_DiskWriteLimit}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown Value="{Binding MaxDiskWriteSpeedBytesPerSecond}" Minimum="0" Increment="1048576" AutomationProperties.Name="{m:L Settings_DiskWriteLimit}" AutomationProperties.AutomationId="MaxDiskWriteSpeedInput"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="TrayFull" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_QueueManagement}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableQueueManagement, Mode=TwoWay}" Content="{m:L Settings_EnableQueueManagement}" AutomationProperties.AutomationId="EnableQueueManagementSwitch"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}" IsEnabled="{Binding EnableQueueManagement}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_MaxActiveDownloads}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown Value="{Binding MaxActiveDownloads}" Minimum="1" AutomationProperties.Name="{m:L Settings_MaxActiveDownloads}" AutomationProperties.AutomationId="MaxActiveDownloadsInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_MaxActiveSeeds}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <NumericUpDown Value="{Binding MaxActiveSeeds}" Minimum="0" AutomationProperties.Name="{m:L Settings_MaxActiveSeeds}" AutomationProperties.AutomationId="MaxActiveSeedsInput"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>
            <!--
                Seeding goals. The engine has always enforced these per torrent and the add dialog
                has always been able to set them; what was missing was an answer for the torrents
                nobody says anything about, which is nearly all of them.
            -->
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="SeedOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_Seeding}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{m:L Settings_SeedingHint}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}" TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <ToggleSwitch IsChecked="{Binding LimitSeedingRatio, Mode=TwoWay}" Content="{m:L Settings_LimitSeedingRatio}" AutomationProperties.AutomationId="LimitSeedingRatioSwitch"/>
                            <NumericUpDown Value="{Binding SeedingRatioLimit}" Minimum="0" Increment="0.1" FormatString="0.0#" IsEnabled="{Binding LimitSeedingRatio}" AutomationProperties.Name="{m:L Settings_LimitSeedingRatio}" AutomationProperties.AutomationId="SeedingRatioLimitInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <ToggleSwitch IsChecked="{Binding LimitSeedingTime, Mode=TwoWay}" Content="{m:L Settings_LimitSeedingTime}" AutomationProperties.AutomationId="LimitSeedingTimeSwitch"/>
                            <NumericUpDown Value="{Binding SeedingTimeLimitMinutes}" Minimum="0" IsEnabled="{Binding LimitSeedingTime}" AutomationProperties.Name="{m:L Settings_LimitSeedingTime}" AutomationProperties.AutomationId="SeedingTimeLimitInput"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_SecurityAndPrivacy}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_SecurityAndPrivacy}" AutomationProperties.AutomationId="SecurityAndPrivacyTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="ShieldLockOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_SecurityAndPrivacy}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_EncryptionMode}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <ComboBox ItemsSource="{Binding EncryptionModeOptions}" SelectedValue="{Binding SelectedEncryptionMode}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_EncryptionMode}" AutomationProperties.AutomationId="EncryptionModeComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingMedium}">
                        <ToggleSwitch IsChecked="{Binding EnableBlocklist, Mode=TwoWay}" Content="{m:L Settings_EnableBlocklist}" AutomationProperties.AutomationId="EnableBlocklistSwitch"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}" IsEnabled="{Binding EnableBlocklist}">
                            <TextBox Text="{Binding BlocklistPath, Mode=TwoWay}" PlaceholderText="{m:L Settings_BlocklistWatermark}" AutomationProperties.Name="{m:L Settings_BlocklistFile}" AutomationProperties.AutomationId="BlocklistPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseBlocklistCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseBlocklistButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="Earth" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_GeoIp}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding EnableGeoIp, Mode=TwoWay}" Content="{m:L Settings_EnableGeoIp}" AutomationProperties.AutomationId="EnableGeoIpSwitch"/>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}" IsEnabled="{Binding EnableGeoIp}">
                        <TextBlock Text="{m:L Settings_GeoIpFile}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingNormal}">
                            <TextBox Text="{Binding GeoIpPath, Mode=TwoWay}" PlaceholderText="{m:L Settings_GeoIpWatermark}" AutomationProperties.Name="{m:L Settings_GeoIpFile}" AutomationProperties.AutomationId="GeoIpPathTextBox"/>
                            <Button Grid.Column="1" Command="{Binding BrowseGeoIpCommand}" ToolTip.Tip="{m:L Settings_Browse}" AutomationProperties.Name="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseGeoIpButton">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </suki:GlassCard>
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="Vpn" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_Proxy}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Settings_ProxyType}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <ComboBox ItemsSource="{Binding ProxyTypeOptions}" SelectedValue="{Binding SelectedProxyType}" SelectedValueBinding="{Binding Value}" HorizontalAlignment="Stretch" AutomationProperties.Name="{m:L Settings_ProxyType}" AutomationProperties.AutomationId="ProxyTypeComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ProxyHost}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding ProxyHost, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_ProxyHost}" AutomationProperties.AutomationId="ProxyHostTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ProxyPort}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding ProxyPort, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_ProxyPort}" AutomationProperties.AutomationId="ProxyPortTextBox"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ProxyUsername}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding ProxyUsername, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_ProxyUsername}" AutomationProperties.AutomationId="ProxyUsernameTextBox"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                            <TextBlock Text="{m:L Settings_ProxyPassword}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                            <TextBox Text="{Binding ProxyPassword, Mode=TwoWay}" PasswordChar="*" AutomationProperties.Name="{m:L Settings_ProxyPassword}" AutomationProperties.AutomationId="ProxyPasswordTextBox"/>
                        </StackPanel>
                    </Grid>

                    <WrapPanel Orientation="Horizontal">
                        <ToggleSwitch IsChecked="{Binding ProxyPeers, Mode=TwoWay}" Content="{m:L Settings_ProxyPeers}" Margin="{StaticResource MediumRightMargin}" AutomationProperties.AutomationId="ProxyPeersSwitch"/>
                        <ToggleSwitch IsChecked="{Binding ProxyTrackers, Mode=TwoWay}" Content="{m:L Settings_ProxyTrackers}" AutomationProperties.AutomationId="ProxyTrackersSwitch"/>
                    </WrapPanel>
                </StackPanel>
            </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_Remote}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_Remote}" AutomationProperties.AutomationId="RemoteTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
                        <suki:GlassCard>
                            <StackPanel Spacing="{StaticResource SpacingStandard}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                                    <materialIcons:MaterialIcon Kind="RemoteDesktop" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                                    <TextBlock Text="{m:L Settings_Remote}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{m:L Settings_RemoteHint}"
                                           Opacity="{StaticResource OpacitySecondary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextWrapping="Wrap"/>

                                <ToggleSwitch x:Name="RemoteEnabledToggle"
                                              IsChecked="{Binding RemoteEnabled}"
                                              Content="{m:L Settings_Remote_Enable}" AutomationProperties.AutomationId="RemoteEnabledSwitch"/>

                                <StackPanel Spacing="{StaticResource SpacingStandard}" IsVisible="{Binding RemoteEnabled}">
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                        <TextBlock Text="{m:L Settings_Remote_Port}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                        <NumericUpDown Value="{Binding RemotePort}" Minimum="1" Maximum="65535" Increment="1" AutomationProperties.Name="{m:L Settings_Remote_Port}" AutomationProperties.AutomationId="RemotePortInput"/>
                                    </StackPanel>

                                    <ToggleSwitch IsChecked="{Binding RemoteAllowRemoteConnections}"
                                                  Content="{m:L Settings_Remote_AllowRemote}" AutomationProperties.AutomationId="RemoteAllowRemoteConnectionsSwitch"/>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpacingLarge}">
                                        <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L Settings_Remote_Username}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                            <TextBox Text="{Binding RemoteUsername, Mode=TwoWay}" AutomationProperties.Name="{m:L Settings_Remote_Username}" AutomationProperties.AutomationId="RemoteUsernameTextBox"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="{StaticResource SpacingXSmall}">
                                            <TextBlock Text="{m:L Settings_Remote_Password}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                            <TextBox Text="{Binding RemotePassword, Mode=TwoWay}" PasswordChar="*" AutomationProperties.Name="{m:L Settings_Remote_Password}" AutomationProperties.AutomationId="RemotePasswordTextBox"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Said here rather than left to a log nobody reads: this
                                         combination is refused at startup. -->
                                    <suki:InfoBar x:Name="RemoteCredentialsWarning"
                                                  IsVisible="{Binding RemoteNeedsCredentials}"
                                                  IsClosable="False"
                                                  Severity="Warning"
                                                  Message="{m:L Settings_Remote_NeedsCredentials}"/>

                                    <TextBlock Text="{m:L Settings_Remote_RestartHint}"
                                               Opacity="{StaticResource OpacityHint}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_Categories}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_Categories}" AutomationProperties.AutomationId="CategoriesTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
                        <suki:GlassCard>
                            <StackPanel Spacing="{StaticResource SpacingStandard}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                                    <materialIcons:MaterialIcon Kind="FolderMultipleOutline" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                                    <TextBlock Text="{m:L Settings_Categories}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{m:L Settings_CategoriesHint}"
                                           Opacity="{StaticResource OpacitySecondary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextWrapping="Wrap"/>

                                <ItemsControl x:Name="CategoryList" ItemsSource="{Binding CategoryList}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="config:TorrentCategory">
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource SpacingMedium}" Margin="{StaticResource XXSmallBottomMargin}">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="120"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SavePath}" Opacity="{StaticResource OpacitySecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2"
                                                        Classes="Basic"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveCategoryCommand}"
                                                        ToolTip.Tip="{m:L Downloads_Remove}"
                                                        CommandParameter="{Binding Name}">
                                                    <materialIcons:MaterialIcon Kind="Close" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid ColumnDefinitions="*,2*,Auto,Auto" ColumnSpacing="{StaticResource SpacingMedium}">
                                    <TextBox Text="{Binding NewCategoryName, Mode=TwoWay}" PlaceholderText="{m:L Settings_Categories_NameWatermark}" AutomationProperties.Name="{m:L Settings_CategoriesHint}" AutomationProperties.AutomationId="NewCategoryNameTextBox"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewCategoryPath, Mode=TwoWay}" PlaceholderText="{m:L Settings_Categories_PathWatermark}" AutomationProperties.Name="{m:L Settings_CategoriesHint}" AutomationProperties.AutomationId="NewCategoryPathTextBox"/>
                                    <Button Grid.Column="2" Command="{Binding BrowseCategoryPathCommand}" Content="{m:L Settings_Browse}" AutomationProperties.AutomationId="BrowseCategoryPathButton"/>
                                    <Button Grid.Column="3" Command="{Binding AddCategoryCommand}" Content="{m:L Settings_Categories_Add}" AutomationProperties.AutomationId="AddCategoryButton"/>
                                </Grid>
                            </StackPanel>
                        </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_Search}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_Search}" AutomationProperties.AutomationId="SearchTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
                        <suki:GlassCard>
                            <StackPanel Spacing="{StaticResource SpacingStandard}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                                    <materialIcons:MaterialIcon Kind="Magnify" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                                    <TextBlock Text="{m:L Settings_Search}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{m:L Settings_SearchHint}"
                                           Opacity="{StaticResource OpacitySecondary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextWrapping="Wrap"/>

                                <!--
                                    The two indexer managers people actually run, so the endpoint
                                    does not have to be typed or looked up. Neither names a torrent
                                    index: which indexes exist is configured inside Prowlarr or
                                    Jackett by whoever runs it.
                                -->
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                                    <Button Command="{Binding UseIndexerPresetCommand}"
                                            CommandParameter="{x:Static config:SearchSettings.ProwlarrTemplate}"
                                            Content="{m:L Settings_Search_UseProwlarr}" AutomationProperties.AutomationId="UseIndexerPresetButton"/>
                                    <Button Command="{Binding UseIndexerPresetCommand}"
                                            CommandParameter="{x:Static config:SearchSettings.JackettTemplate}"
                                            Content="{m:L Settings_Search_UseJackett}" AutomationProperties.AutomationId="SettingsUseIndexerPresetButton"/>
                                    <Button Command="{Binding DetectIndexerCommand}" Classes="Flat" AutomationProperties.Name="{m:L Settings_Search_Detect}" AutomationProperties.AutomationId="DetectIndexerButton">
                                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                                            <materialIcons:MaterialIcon Kind="Radar" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                            <TextBlock Text="{m:L Settings_Search_Detect}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                    <TextBlock Text="{m:L Settings_Search_Url}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                    <TextBox Text="{Binding TorznabUrl, Mode=TwoWay}" PlaceholderText="{x:Static config:SearchSettings.JackettTemplate}" AutomationProperties.Name="{m:L Settings_Search_Url}" AutomationProperties.AutomationId="TorznabUrlTextBox"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpacingMedium}">
                                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                                        <TextBlock Text="{m:L Settings_Search_ApiKey}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                                        <TextBox Text="{Binding TorznabApiKey, Mode=TwoWay}" PasswordChar="*" AutomationProperties.Name="{m:L Settings_Search_ApiKey}" AutomationProperties.AutomationId="TorznabApiKeyTextBox"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Command="{Binding TestIndexerCommand}"
                                            Content="{m:L Settings_Search_Test}"
                                            VerticalAlignment="Bottom" AutomationProperties.AutomationId="TestIndexerButton"/>
                                </Grid>

                                <suki:InfoBar IsVisible="{Binding HasSearchStatusMessage}"
                                              IsClosable="False"
                                              Message="{Binding SearchStatusMessage}"/>
                            </StackPanel>
                        </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{m:L Settings_Updates}" IsVisible="{Binding IsAdvancedMode}" AutomationProperties.Name="{m:L Settings_Updates}" AutomationProperties.AutomationId="UpdatesTab">
                <ScrollViewer>
                    <StackPanel Spacing="{StaticResource SpacingLarge}" MaxWidth="{StaticResource ContentMaxWidth}" Margin="{StaticResource XSmallLeftTopRightBottomMargin}">
            <suki:GlassCard>
                <StackPanel Spacing="{StaticResource SpacingStandard}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                        <materialIcons:MaterialIcon Kind="Update" Foreground="{DynamicResource SukiPrimaryColor}" Width="{StaticResource IconSizeXLarge}" Height="{StaticResource IconSizeXLarge}"/>
                        <TextBlock Text="{m:L Settings_Updates}" FontSize="{StaticResource FontSizeLarge}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L AddTorrent_Version}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <TextBlock Text="{Binding ApplicationVersion}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                    </StackPanel>

                    <StackPanel Spacing="{StaticResource SpacingXSmall}" IsVisible="{Binding IsDirectDownloadUpdateChannel}">
                        <TextBlock Text="{m:L Settings_UpdateUrl}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}"/>
                        <TextBox Text="{Binding UpdateUrl, Mode=TwoWay}" PlaceholderText="{m:L Settings_UpdateUrlWatermark}" AutomationProperties.Name="{m:L Settings_UpdateUrl}" AutomationProperties.AutomationId="UpdateUrlTextBox"/>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding CheckForUpdatesOnStartup, Mode=TwoWay}" Content="{m:L Settings_CheckForUpdatesOnStartup}" IsVisible="{Binding IsDirectDownloadUpdateChannel}" AutomationProperties.AutomationId="CheckForUpdatesOnStartupSwitch"/>

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingStandard}" IsVisible="{Binding IsDirectDownloadUpdateChannel}">
                        <Button Command="{Binding CheckForUpdatesCommand}" AutomationProperties.Name="{m:L Settings_CheckForUpdates}" AutomationProperties.AutomationId="CheckForUpdatesButton">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                                <materialIcons:MaterialIcon Kind="CloudDownloadOutline" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                <TextBlock Text="{m:L Settings_CheckForUpdates}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ApplyUpdateAndRestartCommand}" IsVisible="{Binding IsUpdateAvailable}" Classes="Accent" AutomationProperties.Name="{m:L Settings_ApplyUpdateAndRestart}" AutomationProperties.AutomationId="ApplyUpdateAndRestartButton">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                                <materialIcons:MaterialIcon Kind="RestartAlert" Width="{StaticResource IconSizeMedium}" Height="{StaticResource IconSizeMedium}"/>
                                <TextBlock Text="{m:L Settings_ApplyUpdateAndRestart}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{m:L Settings_UpdateNotInstalled}" Opacity="{StaticResource OpacityDisabled}" FontSize="{StaticResource FontSizeSmall}" IsVisible="{Binding ShouldShowUpdateNotInstalled}"/>
                </StackPanel>
            </suki:GlassCard>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
