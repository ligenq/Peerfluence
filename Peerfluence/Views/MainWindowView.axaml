<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:Peerfluence.ViewModels"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
                 xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                 xmlns:m="using:Peerfluence.Markup"
                 xmlns:views="using:Peerfluence.Views"
                 mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
                 x:Class="Peerfluence.Views.MainWindowView"
                 x:Name="Root"
                 x:DataType="vm:MainWindowViewModel"
                 BackgroundStyle="GradientSoft"
                 BackgroundTransitionsEnabled="True"
                 Icon="/Assets/application-icon.png"
                 Title="{m:L App_Title}"
                 TransparencyLevelHint="None">

    <!--
        SukiWindow's template carries no VisualLayerManager, so nothing under it had an
        OverlayLayer. A popup's light dismiss lives in that layer, which left every context menu
        in the app unable to close on a click. Supplying one here gives the whole content tree a
        layer to find.
    -->
    <primitives:VisualLayerManager>
    <Panel>
    <suki:SukiSideMenu ZIndex="0"
                       ItemsSource="{Binding NavigationItems}"
                       SelectedItem="{Binding SelectedNavigationItem}"
                       IsVisible="{Binding !IsSimpleMode}"
                       UseCustomContent="True">
        <suki:SukiSideMenu.HeaderContent>
            <StackPanel Spacing="{StaticResource SpacingSmall}" Margin="{StaticResource LargeLeftRightTopBottomMargin}">
                <TextBlock Text="{m:L App_Title}" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource SukiPrimaryColor}" />
                <TextBlock Text="{m:L App_Tagline}" Opacity="{StaticResource OpacitySecondary}" FontSize="{StaticResource FontSizeNormal}" Foreground="{DynamicResource SukiLowText}"/>
            </StackPanel>
        </suki:SukiSideMenu.HeaderContent>
        <suki:SukiSideMenu.ItemTemplate>
            <DataTemplate x:DataType="vm:NavigationItem">
                <suki:SukiSideMenuItem Header="{Binding Title}">
                    <suki:SukiSideMenuItem.Icon>
                        <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="{StaticResource IconSizeLarge}" Height="{StaticResource IconSizeLarge}" />
                    </suki:SukiSideMenuItem.Icon>
                </suki:SukiSideMenuItem>
            </DataTemplate>
        </suki:SukiSideMenu.ItemTemplate>
        <suki:SukiSideMenu.FooterContent>
            <!--
                The speeds used to be repeated here as well as on the downloads screen. They live in
                the status strip now, where the rest of the numbers are.
            -->
            <StackPanel Margin="{StaticResource StandardLeftTopBottomMargin}" Spacing="{StaticResource SpacingSmall}">
                <Button Classes="Basic" Command="{Binding ShowAboutCommand}" Padding="{StaticResource ZeroThickness}" Margin="{StaticResource TinyTopMargin}" AutomationProperties.AutomationId="ShowAboutButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="InformationOutline" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Opacity="{StaticResource OpacityDisabled}"/>
                        <TextBlock Text="{m:L Nav_About}" FontSize="{StaticResource FontSizeNormal}" Opacity="{StaticResource OpacityDisabled}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </suki:SukiSideMenu.FooterContent>
        <suki:SukiSideMenu.Content>
            <ContentControl Content="{Binding CurrentPage}" Margin="{StaticResource MediumLeftTopRightBottomMargin}" />
        </suki:SukiSideMenu.Content>
    </suki:SukiSideMenu>

        <!--
            Simple mode: the one screen, and a quiet way back to everything else. No side menu,
            because there is nowhere else to navigate to.
        -->
        <Grid ZIndex="0" RowDefinitions="Auto,*" IsVisible="{Binding IsSimpleMode}" Margin="{StaticResource MediumLeftTopRightBottomMargin}">
            <!--
                The only chrome simple mode gets: a way into settings and a way out to advanced,
                muted and out of the way of the one thing the screen is for.
            -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="{StaticResource SpacingMedium}"
                        HorizontalAlignment="Right">
                <Button Classes="Basic"
                        Command="{Binding ShowSimpleSettingsCommand}"
                        IsVisible="{Binding !IsSimpleSettingsOpen}" AutomationProperties.AutomationId="ShowSimpleSettingsButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="Cog" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Opacity="{StaticResource OpacitySecondary}"/>
                        <TextBlock Text="{m:L Settings_Title}" FontSize="{StaticResource FontSizeNormal}" Opacity="{StaticResource OpacitySecondary}"/>
                    </StackPanel>
                </Button>
                <Button Classes="Basic"
                        Command="{Binding CloseSimpleSettingsCommand}"
                        IsVisible="{Binding IsSimpleSettingsOpen}" AutomationProperties.AutomationId="CloseSimpleSettingsButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="ArrowLeft" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Opacity="{StaticResource OpacitySecondary}"/>
                        <TextBlock Text="{m:L Nav_Downloads}" FontSize="{StaticResource FontSizeNormal}" Opacity="{StaticResource OpacitySecondary}"/>
                    </StackPanel>
                </Button>
                <Button Classes="Basic" Command="{Binding SwitchToAdvancedModeCommand}" AutomationProperties.AutomationId="SwitchToAdvancedModeButton">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSmallPlus}">
                        <materialIcons:MaterialIcon Kind="TuneVariant" Width="{StaticResource IconSizeSmall}" Height="{StaticResource IconSizeSmall}" Opacity="{StaticResource OpacitySecondary}"/>
                        <TextBlock Text="{m:L Simple_SwitchToAdvanced}" FontSize="{StaticResource FontSizeNormal}" Opacity="{StaticResource OpacitySecondary}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Panel Grid.Row="1" IsVisible="{Binding !IsSimpleSettingsOpen}">
                <views:SimpleDownloadsView DataContext="{Binding DownloadsViewModel}"/>
            </Panel>
            <ContentControl Grid.Row="1"
                            Content="{Binding SettingsPage}"
                            IsVisible="{Binding IsSimpleSettingsOpen}"/>
        </Grid>

        <!--
            First run only. A preference, asked plainly and once: left-aligned, ordinary type, no
            hero and no decoration. The thing being chosen is which interface to show, not a product
            to be sold.
        -->
        <Border ZIndex="10" IsVisible="{Binding IsWelcomeVisible}" Background="{DynamicResource SukiGlassCardOpaqueBackground}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingStandard}"
                        MaxWidth="420">
                <TextBlock Text="{m:L Welcome_Title}"
                           FontSize="{StaticResource FontSizeLarge}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{m:L Welcome_Subtitle}"
                           Opacity="{StaticResource OpacitySecondary}"
                           TextWrapping="Wrap"
                           Margin="{StaticResource StandardBottomMargin}"/>

                <Button Command="{Binding ChooseSimpleModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="{StaticResource NormalLeftTopRightBottomMargin}" AutomationProperties.AutomationId="ChooseSimpleModeButton">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Welcome_Simple_Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{m:L Welcome_Simple_Body}" Opacity="{StaticResource OpacitySecondary}" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ChooseAdvancedModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="{StaticResource NormalLeftTopRightBottomMargin}" AutomationProperties.AutomationId="ChooseAdvancedModeButton">
                    <StackPanel Spacing="{StaticResource SpacingXSmall}">
                        <TextBlock Text="{m:L Welcome_Advanced_Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{m:L Welcome_Advanced_Body}" Opacity="{StaticResource OpacitySecondary}" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Panel>
    </primitives:VisualLayerManager>
</suki:SukiWindow>
