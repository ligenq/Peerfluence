<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Peerfluence.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:overlay="using:Peerfluence.Theme.Controls"
        xmlns:m="using:Peerfluence.Markup"
        xmlns:views="using:Peerfluence.Views"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="720"
        x:Class="Peerfluence.Views.MainWindowView"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/application-icon.png"
        Title="{m:L App_Title}"
        MinWidth="900"
        MinHeight="560"
        Background="{DynamicResource PfCanvas}">

    <!--
        Native window decorations rather than drawn ones. A custom title bar has to be rebuilt for
        each platform's buttons, snapping and accessibility, and Peerfluence targets three; the
        interface earns its character below the title bar instead.
    -->

    <Panel>
        <!-- Advanced: a sidebar of destinations beside the current one. -->
        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !IsSimpleMode}">

            <!-- Painted by the theme rather than here: a local value outranks a style setter, so
                 a variant that wants its own sidebar treatment could not override it from here. -->
            <Border Grid.Column="0"
                    Classes="sidebar"
                    Width="{StaticResource PfSidebarWidth}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!--
                        The name, stated once and quietly. It was a large coloured wordmark, which
                        is an advertisement; the application is already open, so the reader knows
                        what they launched.
                    -->
                    <StackPanel Grid.Row="0" Margin="{StaticResource SidebarHeaderMargin}" Spacing="{StaticResource SpacingTiny}">
                        <TextBlock Text="{m:L App_Title}" FontWeight="SemiBold" FontSize="{StaticResource PfFontBodyLarge}" />
                        <TextBlock Text="{m:L App_Tagline}" Classes="caption" />
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             Classes="nav"
                             AutomationProperties.AutomationId="NavigationList"
                             AutomationProperties.Name="{m:L Nav_Navigation}"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItem">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingMedium}"
                                            AutomationProperties.Name="{Binding Title}">
                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="17" Height="17" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2"
                            Classes="ghost nav"
                            Classes.selected="{Binding IsAboutSelected}"
                            Margin="{StaticResource SidebarFooterMargin}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Command="{Binding ShowAboutCommand}"
                            AutomationProperties.Name="{m:L Nav_About}"
                            AutomationProperties.AutomationId="ShowAboutButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingMedium}">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="17" Height="17" />
                            <TextBlock Text="{m:L Nav_About}" />
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>

            <ContentControl Grid.Column="1"
                            Padding="{StaticResource MediumLeftTopRightBottomMargin}"
                            Content="{Binding CurrentPage}" />
        </Grid>

        <!--
            Simple mode: the one screen, and a quiet way back to everything else. No sidebar,
            because there is nowhere else to navigate to.
        -->
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding IsSimpleMode}">
            <Border Grid.Row="0"
                    Background="{DynamicResource PfSurface}"
                    BorderBrush="{DynamicResource PfBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="{StaticResource HeaderBarPadding}">
                <StackPanel Orientation="Horizontal"
                            Height="{StaticResource PfHeaderHeight}"
                            Spacing="{StaticResource SpacingSmall}"
                            HorizontalAlignment="Right">
                    <Button Classes="ghost"
                            VerticalAlignment="Center"
                            Command="{Binding ShowSimpleSettingsCommand}"
                            IsVisible="{Binding !IsSimpleSettingsOpen}"
                            AutomationProperties.Name="{m:L Settings_Title}"
                            AutomationProperties.AutomationId="ShowSimpleSettingsButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="Cog" Width="15" Height="15" />
                            <TextBlock Text="{m:L Settings_Title}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost"
                            VerticalAlignment="Center"
                            Command="{Binding CloseSimpleSettingsCommand}"
                            IsVisible="{Binding IsSimpleSettingsOpen}"
                            AutomationProperties.Name="{m:L Nav_Downloads}"
                            AutomationProperties.AutomationId="CloseSimpleSettingsButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="ArrowLeft" Width="15" Height="15" />
                            <TextBlock Text="{m:L Nav_Downloads}" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost"
                            VerticalAlignment="Center"
                            Command="{Binding SwitchToAdvancedModeCommand}"
                            AutomationProperties.Name="{m:L Simple_SwitchToAdvanced}"
                            AutomationProperties.AutomationId="SwitchToAdvancedModeButton">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingNormal}">
                            <materialIcons:MaterialIcon Kind="TuneVariant" Width="15" Height="15" />
                            <TextBlock Text="{m:L Simple_SwitchToAdvanced}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Panel Grid.Row="1"
                   Margin="{StaticResource MediumLeftTopRightBottomMargin}"
                   IsVisible="{Binding !IsSimpleSettingsOpen}">
                <!-- Built on entering simple mode, not on startup: the content is null until then. -->
                <ContentControl Content="{Binding SimpleDownloadsPage}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:DownloadsViewModel">
                            <views:SimpleDownloadsView />
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </Panel>
            <ContentControl Grid.Row="1"
                            Padding="{StaticResource MediumLeftTopRightBottomMargin}"
                            Content="{Binding SettingsPage}"
                            IsVisible="{Binding IsSimpleSettingsOpen}"/>
        </Grid>

        <!--
            First run only. A preference, asked plainly and once: left-aligned, ordinary type, no
            hero and no decoration. The thing being chosen is which interface to show, not a product
            to be sold.
        -->
        <Border ZIndex="40" IsVisible="{Binding IsWelcomeVisible}" Background="{DynamicResource PfCanvas}">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="{StaticResource SpacingMedium}"
                        MaxWidth="420">
                <TextBlock Text="{m:L Welcome_Title}" Classes="subtitle" />
                <TextBlock Text="{m:L Welcome_Subtitle}"
                           Classes="secondary"
                           TextWrapping="Wrap"
                           Margin="{StaticResource NormalBottomMargin}"/>

                <Button Command="{Binding ChooseSimpleModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="{StaticResource ChoiceCardPadding}"
                        AutomationProperties.Name="{m:L Welcome_Simple_Title}"
                        AutomationProperties.AutomationId="ChooseSimpleModeButton">
                    <StackPanel Spacing="{StaticResource SpacingTiny}">
                        <TextBlock Text="{m:L Welcome_Simple_Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{m:L Welcome_Simple_Body}" Classes="secondary" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Button>

                <Button Command="{Binding ChooseAdvancedModeCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="{StaticResource ChoiceCardPadding}"
                        AutomationProperties.Name="{m:L Welcome_Advanced_Title}"
                        AutomationProperties.AutomationId="ChooseAdvancedModeButton">
                    <StackPanel Spacing="{StaticResource SpacingTiny}">
                        <TextBlock Text="{m:L Welcome_Advanced_Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{m:L Welcome_Advanced_Body}" Classes="secondary" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Above everything, and hit-testing nothing while closed. -->
        <overlay:ToastHost ZIndex="20" Manager="{Binding ToastManager}" DismissLabel="{m:L Common_Close}" />
        <overlay:DialogHost ZIndex="30" Manager="{Binding DialogManager}" />
    </Panel>
</Window>
