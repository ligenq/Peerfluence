      <Color x:Key="SkyTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="SkyAccentStrongColor">#236FB2</Color>
      <Color x:Key="SkyAccentStrongHoverColor">#194D93</Color>
      <Color x:Key="SkyAccentStrongPressedColor">#2065A9</Color>
      <Color x:Key="CyanAccentColor">#1673A7</Color>
      <Color x:Key="CyanAccentHoverColor">#156AA0</Color>
      <Color x:Key="CyanAccentPressedColor">#14619A</Color>
      <Color x:Key="CyanAccentSubtleColor">#E8F1F6</Color>
      <Color x:Key="CyanAccentMutedColor">#BED8E6</Color>
      <Color x:Key="CyanTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="CyanAccentStrongColor">#1672A6</Color>
      <Color x:Key="CyanAccentStrongHoverColor">#124F8C</Color>
      <Color x:Key="CyanAccentStrongPressedColor">#15679E</Color>
      <Color x:Key="EmeraldAccentColor">#0D7882</Color>
      <Color x:Key="EmeraldAccentHoverColor">#0D6F7F</Color>
      <Color x:Key="EmeraldAccentPressedColor">#0D657C</Color>
      <Color x:Key="EmeraldAccentSubtleColor">#E7F2F2</Color>
      <Color x:Key="EmeraldAccentMutedColor">#BBD9DC</Color>
      <Color x:Key="EmeraldTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="EmeraldAccentStrongColor">#0D7882</Color>
      <Color x:Key="EmeraldAccentStrongHoverColor">#0C5276</Color>
      <Color x:Key="EmeraldAccentStrongPressedColor">#0D6D7F</Color>
      <Color x:Key="RoseAccentColor">#CB265D</Color>
      <Color x:Key="RoseAccentHoverColor">#B8255E</Color>
      <Color x:Key="RoseAccentPressedColor">#A5245F</Color>
      <Color x:Key="RoseAccentSubtleColor">#FAE9EF</Color>
      <Color x:Key="RoseAccentMutedColor">#F0C2D2</Color>
