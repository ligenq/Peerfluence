      <Color x:Key="EmeraldAccentSubtleColor">#192C2C</Color>
      <Color x:Key="EmeraldAccentMutedColor">#1E4D42</Color>
      <Color x:Key="EmeraldTextOnAccentColor">#0F1115</Color>
      <Color x:Key="AmberAccentColor">#FBBF24</Color>
      <Color x:Key="AmberAccentHoverColor">#FBC73E</Color>
      <Color x:Key="AmberAccentPressedColor">#FCCD54</Color>
      <Color x:Key="AmberAccentSubtleColor">#2D2A20</Color>
      <Color x:Key="AmberAccentMutedColor">#564721</Color>
      <Color x:Key="AmberTextOnAccentColor">#0F1115</Color>
      <Color x:Key="RoseAccentColor">#FB7185</Color>
      <Color x:Key="RoseAccentHoverColor">#FB8294</Color>
      <Color x:Key="RoseAccentPressedColor">#FC90A0</Color>
      <Color x:Key="RoseAccentSubtleColor">#2D222A</Color>
      <Color x:Key="RoseAccentMutedColor">#56323C</Color>
      <Color x:Key="RoseTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="VioletAccentColor">#A78BFA</Color>
      <Color x:Key="VioletAccentHoverColor">#B299FB</Color>
      <Color x:Key="VioletAccentPressedColor">#BAA5FB</Color>
      <Color x:Key="VioletAccentSubtleColor">#242436</Color>
      <Color x:Key="VioletAccentMutedColor">#3F395D</Color>
      <Color x:Key="VioletTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="SlateAccentColor">#94A3B8</Color>
      <Color x:Key="SlateAccentHoverColor">#A1AEC1</Color>
      <Color x:Key="SlateAccentPressedColor">#ACB7C8</Color>
      <Color x:Key="SlateAccentSubtleColor">#23272F</Color>
      <Color x:Key="SlateAccentMutedColor">#39404B</Color>
      <Color x:Key="SlateTextOnAccentColor">#FFFFFF</Color>
    </ResourceDictionary>

    <!--
      Midnight. Not a copy of Dark: its tints are mixed toward the indigo surface rather than
      toward near-black, and its bases are lifted only as far as WCAG AA requires against those
      surfaces - four of them needed no lift at all. Regenerate with
      tools/generate-midnight-accents.py rather than editing by hand.
    -->
    <ResourceDictionary x:Key="{x:Static pf:PeerfluenceTheme.Midnight}">
      <Color x:Key="TealAccentColor">#00D5C8</Color>
      <Color x:Key="TealAccentHoverColor">#1AD9CE</Color>
      <Color x:Key="TealAccentPressedColor">#33DDD3</Color>
      <Color x:Key="TealAccentSubtleColor">#132650</Color>
      <Color x:Key="TealAccentMutedColor">#0F4968</Color>
      <Color x:Key="TealTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="TealAccentStrongColor">#067881</Color>
      <Color x:Key="TealAccentStrongHoverColor">#05838A</Color>
      <Color x:Key="TealAccentStrongPressedColor">#076B77</Color>
      <Color x:Key="CobaltAccentColor">#3B88FE</Color>
      <Color x:Key="CobaltAccentHoverColor">#4F94FE</Color>
      <Color x:Key="CobaltAccentPressedColor">#62A0FE</Color>
      <Color x:Key="CobaltAccentSubtleColor">#191E56</Color>
      <Color x:Key="CobaltAccentMutedColor">#203377</Color>
      <Color x:Key="CobaltTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="CobaltAccentStrongColor">#3069CA</Color>
      <Color x:Key="CobaltAccentStrongHoverColor">#3473DB</Color>
      <Color x:Key="CobaltAccentStrongPressedColor">#2C5EB7</Color>
      <Color x:Key="SkyAccentColor">#38BDF8</Color>
      <Color x:Key="SkyAccentHoverColor">#4CC4F9</Color>
      <Color x:Key="SkyAccentPressedColor">#60CAF9</Color>
      <Color x:Key="SkyAccentSubtleColor">#182355</Color>
      <Color x:Key="SkyAccentMutedColor">#1F4276</Color>
      <Color x:Key="SkyTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="SkyAccentStrongColor">#2672A3</Color>
      <Color x:Key="SkyAccentStrongHoverColor">#297DB0</Color>
      <Color x:Key="SkyAccentStrongPressedColor">#236695</Color>
      <Color x:Key="CyanAccentColor">#22D3EE</Color>
      <Color x:Key="CyanAccentHoverColor">#38D7F0</Color>
      <Color x:Key="CyanAccentPressedColor">#4EDCF1</Color>
      <Color x:Key="CyanAccentSubtleColor">#162554</Color>
      <Color x:Key="CyanAccentMutedColor">#194873</Color>
      <Color x:Key="CyanTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="CyanAccentStrongColor">#197594</Color>
      <Color x:Key="CyanAccentStrongHoverColor">#1A809F</Color>
      <Color x:Key="CyanAccentStrongPressedColor">#186888</Color>
      <Color x:Key="EmeraldAccentColor">#10D9A0</Color>
      <Color x:Key="EmeraldAccentHoverColor">#28DDAA</Color>
      <Color x:Key="EmeraldAccentPressedColor">#40E1B3</Color>
      <Color x:Key="EmeraldAccentSubtleColor">#14264C</Color>
      <Color x:Key="EmeraldAccentMutedColor">#144A5D</Color>
      <Color x:Key="EmeraldTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="EmeraldAccentStrongColor">#0F7A6C</Color>
      <Color x:Key="EmeraldAccentStrongHoverColor">#0F8572</Color>
      <Color x:Key="EmeraldAccentStrongPressedColor">#0F6D65</Color>
      <Color x:Key="RoseAccentColor">#F44772</Color>
      <Color x:Key="RoseAccentHoverColor">#F55980</Color>
      <Color x:Key="RoseAccentPressedColor">#F66C8E</Color>
      <Color x:Key="RoseAccentSubtleColor">#2B1748</Color>
      <Color x:Key="RoseAccentMutedColor">#532150</Color>
      <Color x:Key="RoseTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="RoseAccentStrongColor">#BF3962</Color>
      <Color x:Key="RoseAccentStrongHoverColor">#D33E68</Color>
      <Color x:Key="RoseAccentStrongPressedColor">#AA335C</Color>
      <Color x:Key="VioletAccentColor">#9772FF</Color>
      <Color x:Key="VioletAccentHoverColor">#A180FF</Color>
      <Color x:Key="VioletAccentPressedColor">#AC8EFF</Color>
      <Color x:Key="VioletAccentSubtleColor">#221C56</Color>
      <Color x:Key="VioletAccentMutedColor">#392D78</Color>
      <Color x:Key="VioletTextOnAccentColor">#0E0B2E</Color>
      <Color x:Key="VioletAccentStrongColor">#7558CB</Color>
      <Color x:Key="VioletAccentStrongHoverColor">#8061DC</Color>
      <Color x:Key="VioletAccentStrongPressedColor">#694FB8</Color>
    </ResourceDictionary>

    <!-- Midnight Light. Same hues, moved the other way: darkened toward the ink until they
         read on white, rather than lifted toward white until they read on indigo.
         Regenerate with tools/generate-midnight-accents.py light. -->
    <ResourceDictionary x:Key="{x:Static pf:PeerfluenceTheme.MidnightLight}">
      <Color x:Key="TealAccentColor">#067696</Color>
      <Color x:Key="TealAccentHoverColor">#066D91</Color>
      <Color x:Key="TealAccentPressedColor">#07648C</Color>
      <Color x:Key="TealAccentSubtleColor">#E6F1F4</Color>
      <Color x:Key="TealAccentMutedColor">#B9D9E2</Color>
      <Color x:Key="TealTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="TealAccentStrongColor">#067596</Color>
      <Color x:Key="TealAccentStrongHoverColor">#085182</Color>
      <Color x:Key="TealAccentStrongPressedColor">#076A90</Color>
      <Color x:Key="CobaltAccentColor">#0160F5</Color>
      <Color x:Key="CobaltAccentHoverColor">#0259E7</Color>
      <Color x:Key="CobaltAccentPressedColor">#0352D8</Color>
      <Color x:Key="CobaltAccentSubtleColor">#E6EFFE</Color>
      <Color x:Key="CobaltAccentMutedColor">#B8D2FC</Color>
      <Color x:Key="CobaltTextOnAccentColor">#FFFFFF</Color>
      <Color x:Key="CobaltAccentStrongColor">#0160F5</Color>
      <Color x:Key="CobaltAccentStrongHoverColor">#0544BB</Color>
      <Color x:Key="CobaltAccentStrongPressedColor">#0258E4</Color>
      <Color x:Key="SkyAccentColor">#2370B3</Color>
      <Color x:Key="SkyAccentHoverColor">#2167AB</Color>
      <Color x:Key="SkyAccentPressedColor">#1E5FA3</Color>
