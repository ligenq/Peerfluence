      <Color x:Key="RoseAccentStrongHoverColor">#7E2160</Color>
      <Color x:Key="RoseAccentStrongPressedColor">#B4255E</Color>
      <Color x:Key="VioletAccentColor">#744AF6</Color>
      <Color x:Key="VioletAccentHoverColor">#6A45E8</Color>
      <Color x:Key="VioletAccentPressedColor">#5F40D9</Color>
