<Project>
  <PropertyGroup>
    <!-- Kept in one place so the projects do not drift to different package versions. -->
    <PeerSharpPackageVersion>4.0.0</PeerSharpPackageVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Warnings are errors because the ones that mattered here were invisible among the ones that did
      not. The ninety-four this replaced included two possible-null dereferences, four uses of
      metadata that the trimmed release build is allowed to remove, and twenty-eight tests that could
      hang for ever rather than be cancelled - none of which anything would ever have failed on.

      The bar is now zero. Anything genuinely not worth fixing is suppressed at the line that causes
      it, with a justification, rather than left to accumulate.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Keep compiler, SDK analyzer, and configured code-style diagnostics identical locally and
         in CI. The SDK itself is pinned in global.json, so analyzer waves cannot move underneath a
         release without an explicit dependency update. -->
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Audit direct and transitive dependencies during every restore. A moderate-or-higher
         advisory is a warning and therefore fails the build under the zero-warning policy. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Peerfluence.Tests'
      Or '$(MSBuildProjectName)' == 'Peerfluence.HeadlessTests'
      Or '$(MSBuildProjectName)' == 'Peerfluence.UiTests'">
    <!-- Underscores separate the arrange/condition/outcome clauses in executable test names. The
         public-library naming rule makes those specifications harder to scan and has no API impact. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
